# PFM configuration for the Alpine (OpenRC) install.
# Installed as /etc/pfm/config.toml (root:pfm, mode 0640). Edit, then:
#   rc-service pfm restart
# Any value can also be overridden with PFM_* variables in /etc/conf.d/pfm
# (nested separator "__", e.g. PFM_SERVER__PORT=9000).

[server]
# 0.0.0.0 = reachable from the LAN. Use 127.0.0.1 if a reverse proxy on the
# same host terminates the connection.
host = "0.0.0.0"
port = 9999

[database]
engine = "sqlite"
# Absolute path: the service working directory is /var/lib/pfm.
sqlite_path = "/var/lib/pfm/pfm.db"
sqlite_apply_pragmas = true
sqlite_max_connections = 1

[i18n]
default_locale = "en"
available_locales = ["en", "it"]

[static]
# The frontend (web/) is compiled into the binary.
source = "embedded"
dir = "/usr/share/pfm/web"

[security]
# Generated by install.sh. Min 32 chars. Changing it logs everybody out.
session_secret = "@SESSION_SECRET@"
session_max_age_s = 86400
session_cookie_name = "pfm_session"
csrf_cookie_name = "pfm_csrf"
# Plain HTTP on the LAN: keep false. Set to true ONLY behind a TLS-terminating
# reverse proxy (it also marks the cookies Secure: over plain HTTP the browser
# would drop them and login would stop working).
trust_proxy = false
# With trust_proxy = true, list the proxy IP(s) or CIDR blocks, e.g.
# ["192.168.10.1"]. Leaving it empty trusts X-Forwarded-For from ANY peer, so
# anyone who can reach the port directly can fake their address and bypass the
# login throttling. Also firewall the port so only the proxy can reach it.
trusted_proxies = []
# Cookies get the Secure flag (and responses HSTS) when this is true. Unset it
# follows trust_proxy. Set it to true behind an HTTPS reverse proxy; leave it
# off while you still open http://<ip>:9999/ directly, or login will break.
# secure_cookies = true
csp = "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"

[security.argon2]
memory_kib = 65536
iterations = 3
parallelism = 4

[security.rate_limit_login]
per_min = 5
window_s = 60

[logging]
level = "info"

[scheduler]
enabled = true
interval_secs = 3600
